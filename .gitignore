# ══════════════════════════════════════════════════════════════
#  song-jury .gitignore —— ⚠️ 白名單制(2026-07-29 改)
#
#  為什麼改成白名單:舊版是黑名單,結果 _C層得獎歌/(54 首金曲/葛萊美得獎歌 mp3)、
#  _stems/(7.4GB Demucs 分軌)、10 個內部實驗資料夾全都沒被擋 —— 一 push 就是版權事故。
#  黑名單「忘了寫就外洩」,白名單「忘了寫就不外洩」—— 公開 repo 只能用後者。
#
#  規則:先全部忽略,再逐項放行(!)。新增檔案要進 repo → 自己在下面補一行 !。
# ══════════════════════════════════════════════════════════════

# ── 第一步:全部忽略 ──
/*
/*/

# ── 第二步:放行「說明與設定」──
!.gitignore
!.gitattributes
!README.md
!LICENSE
!SKILL.md
!.env.example
!requirements.txt
!requirements-ml.txt
!requirements-audition.txt
!requirements-demucs.txt
!requirements-web.txt

# ── 放行「程式」──
!評審團.py
!song_scorer.py
!和聲分析.py
!編曲層次.py
# ⚠️ 下面兩支是 編曲層次/和聲分析/評審團 共用的底層,漏放行 = 別人 clone 下來
#    頂層 import 就 ModuleNotFoundError,和聲柱+結構編曲柱+人聲柱大半細項一起死。
#    新增任何 .py 前先問:有沒有別的檔 import 它 / subprocess 呼叫它?
!分軌快取.py
!伴奏混音.py
# 狀態目錄:工作鎖/Gemini 冷卻的全域位置(評審團+Gemini曲評 共用底層,同上鐵則)
!狀態目錄.py
# 子程序:逾時殺整棵程序樹(評審團/批次/app 共用底層)
!子程序.py
# 安裝器共用小工具(逐把驗金鑰/獨立驗報告 JSON;stdlib-only)
!金鑰驗證.py
!驗證報告.py
# 金鑰政策:哪幾把金鑰會被用(驗證器與執行期共用的唯一真理來源)
!金鑰政策.py
# 比較器:PK 與抽卡的規則寫死在程式裡(不是「由 AI 臨場編排」)
!比較.py
!Gemini曲評.py
!演唱聽感.py
!真實距離.py
!情感弧線.py
!顯示規則.py
!批次評測.py
!曲評測清單.py
!報告轉PDF.py
!轉PNG.py
!brand_logo.py
!setup_nrcvad.py
!make_demo_song.py
!install.ps1
!install.sh
!一鍵安裝.bat
!app.py
!run_web.ps1
!run_web.sh

# ── 放行「規則與尺」(系統的靈魂,必須隨包)──
!評詞標準.md
!得獎精神綱要.md
!全評測內容總清單.md
!親聽檢查清單.md
!rubrics/
!rubrics/**
!docs/
!docs/**
# 給打包者的內部文件,不進公開包(⚠ gitignore 不支援行內註解,註解要自成一行)
docs/PACKAGING.md

# ── 放行「錨參照」(衍生統計,不是音檔;別人靠它復現打分)──
!_錨參照/
!_錨參照/**

# ── 放行「安裝驗證用 demo」(合成音,非真實作品)──
!demo_mix.wav
!demo_report.json

# ── 放行「四語範例歌曲」(作者自己的 SUNO 作品,同意公開散布)──
# ⚠️ 只放 中/英/日/韓 各一首 mp3+歌詞 txt;其他任何音檔仍被上面的 /* 擋住
!examples/
!examples/**

# ── 放行 assets(logo 等品牌素材)──
!assets/
!assets/**

# ── 放行測試與 CI(⛔ 少了它們,改壞了不會有人知道)──
!tests/
!tests/**
# 放行 tests/** 之後要把編譯快取排回去(它是每次跑測試都會變的垃圾)
tests/__pycache__/
tests/**/__pycache__/
*.pyc
!.github/
!.github/**
!requirements-dev.txt
!pytest.ini

# ══════════════════════════════════════════════════════════════
#  以下永遠不進 repo(即使有人手滑加了 ! 也請刪掉)
#  ⛔ 版權:_C層得獎歌/(得獎歌 mp3)、_stems/(分軌)、下載/(測試歌)
#  ⛔ 內部實驗:_批次結果*/、_審核/、_效度測試*/、_Gemini54/、_試聽驗證/、
#              _編碼實驗/、_得獎歌詞鑑別/、_網址*.txt、_歌單*.txt、_C層*.txt
#  ⛔ 金鑰:.env、.gemini_key_state.json
#  ⛔ 個人校準層:個人整理資料/、_個人*/(雙層架構鐵則:錨點判例出廠為空)
#  ⛔ 授權不可再散布:SongEval/(CC BY-NC-SA)、lexicon/nrc-vad/(禁再散布)
#  ⛔ 環境:.venv*/、__pycache__/
# ══════════════════════════════════════════════════════════════
